    "kleur": "4.1.5",
    "nock": "13.5.6",
    "nodemon": "3.1.10",
    "npm-run-all2": "8.0.4",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "rimraf": "6.1.3",
    "selfsigned": "5.5.0",
    "semver": "7.8.5",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "tsx": "4.22.4",
    "typescript": "7.0.2",
    "undici-types": "6.21.0",
    "update-ts-references": "6.0.0",
    "verdaccio-audit": "workspace:*",
    "verdaccio-auth-memory": "workspace:*",
