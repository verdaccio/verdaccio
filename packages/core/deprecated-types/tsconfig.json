{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "noImplicitAny": false,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "./build",
    "moduleResolution": "bundler",
    "types": ["node"]
  }
}
