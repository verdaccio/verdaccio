{
  "name": "verdaccio-audit",
  "version": "13.0.5",
  "description": "Verdaccio Middleware plugin to bypass npmjs audit",
  "keywords": [
    "enterprise",
    "modules",
    "package",
    "private",
    "proxy",
    "registry",
    "repository",
    "server",
    "verdaccio"
  ],
  "homepage": "https://verdaccio.org",
  "bugs": {
    "url": "https://github.com/verdaccio/verdaccio/issues"
  },
  "license": "MIT",
  "author": "Juan Picado <juanpicado19@gmail.com>",
  "repository": {
    "type": "https",
    "url": "https://github.com/verdaccio/verdaccio",
    "directory": "packages/plugins/audit"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/verdaccio"
  },
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "./build/*": "./build/*"
  },
  "scripts": {
    "clean": "rimraf ./build",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "watch": "vite build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@verdaccio/config": "workspace:8.1.4",
    "@verdaccio/core": "workspace:8.1.4",
    "express": "4.22.1",
    "https-proxy-agent": "5.0.1",
    "node-fetch": "cjs"
  },
  "devDependencies": {
    "@verdaccio/auth": "workspace:8.0.6",
    "@verdaccio/logger": "workspace:8.0.5",
    "@verdaccio/types": "workspace:13.0.5",
    "nock": "13.5.6",
    "supertest": "7.1.4",
    "vite": "8.0.16",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
