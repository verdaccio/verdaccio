{
  "name": "@verdaccio/local-storage-legacy",
  "version": "11.3.6",
  "description": "Local storage implementation",
  "keywords": [
    "local-storage",
    "plugin",
    "storage",
    "verdaccio"
  ],
  "homepage": "https://verdaccio.org",
  "bugs": {
    "url": "https://github.com/verdaccio/verdaccio/issues"
  },
  "license": "MIT",
  "author": "Juan Picado <juanpicado19@gmail.com>",
  "repository": {
    "type": "https",
    "url": "https://github.com/verdaccio/verdaccio",
    "directory": "packages/plugins/local-storage-legacy"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/verdaccio"
  },
  "files": [
    "lib/"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./lib/*": "./lib/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf ./lib",
    "test": "vitest run --reporter=verbose",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@verdaccio/core": "workspace:*",
    "@verdaccio/file-locking": "workspace:*",
    "@verdaccio/streams": "workspace:*",
    "debug": "4.4.3",
    "globby": "11.1.0",
    "lodash": "4.18.1",
    "lowdb": "1.0.0",
    "mkdirp": "1.0.4",
    "sanitize-filename": "1.6.4"
  },
  "devDependencies": {
    "@types/minimatch": "3.0.5",
    "@types/node": "22.20.1",
    "@verdaccio/types": "workspace:*",
    "minimatch": "4.2.6",
    "rmdir-sync": "1.0.1",
    "vite": "8.0.16",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
