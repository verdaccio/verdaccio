{
  "name": "@verdaccio/test-helper",
  "version": "4.0.8",
  "description": "Verdaccio Test Helpers",
  "homepage": "https://verdaccio.org",
  "bugs": {
    "url": "https://github.com/verdaccio/verdaccio/issues"
  },
  "license": "MIT",
  "author": "Juan Picado <juanpicado19@gmail.com>",
  "repository": {
    "type": "https",
    "url": "https://github.com/verdaccio/verdaccio",
    "directory": "packages/test-helper"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/verdaccio"
  },
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "./build/*": "./build/*"
  },
  "scripts": {
    "test": "vitest run",
    "clean": "rimraf ./build",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "watch": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json"
  },
  "dependencies": {
    "@verdaccio/auth": "workspace:8.0.6",
    "@verdaccio/config": "workspace:8.1.4",
    "@verdaccio/core": "workspace:8.1.4",
    "@verdaccio/logger": "workspace:8.0.5",
    "@verdaccio/middleware": "workspace:8.0.7",
    "@verdaccio/types": "workspace:13.0.5",
    "body-parser": "1.20.4",
    "debug": "4.4.3",
    "express": "4.22.1",
    "fs-extra": "11.2.0",
    "supertest": "7.1.4"
  },
  "devDependencies": {
    "vite": "8.0.16"
  }
}
