{
  "name": "@verdaccio/middleware",
  "version": "8.1.0",
  "description": "Verdaccio Express Middleware",
  "keywords": [
    "enterprise",
    "modules",
    "package",
    "private",
    "proxy",
    "registry",
    "repository",
    "server",
    "verdaccio"
  ],
  "homepage": "https://verdaccio.org",
  "bugs": {
    "url": "https://github.com/verdaccio/verdaccio/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Juan Picado",
    "email": "juanpicado19@gmail.com"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/verdaccio/verdaccio",
    "directory": "packages/middleware"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/verdaccio"
  },
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "./build/*": "./build/*"
  },
  "scripts": {
    "clean": "rimraf ./build",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "watch": "vite build --watch",
    "test": "vitest run",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json"
  },
  "dependencies": {
    "@verdaccio/config": "workspace:8.2.0",
    "@verdaccio/core": "workspace:8.2.0",
    "@verdaccio/url": "workspace:13.1.0",
    "debug": "4.4.3",
    "express": "4.22.1",
    "express-rate-limit": "5.5.1",
    "lodash": "4.18.1",
    "lru-cache": "7.18.3"
  },
  "devDependencies": {
    "@verdaccio/logger": "workspace:8.1.0",
    "@verdaccio/types": "workspace:13.0.5",
    "http-errors": "2.0.1",
    "jsdom": "26.1.0",
    "supertest": "7.1.4",
    "vite": "8.0.16",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
