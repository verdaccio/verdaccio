{
  "name": "@verdaccio/loaders",
  "version": "8.1.3",
  "description": "Verdaccio Loader Logic",
  "keywords": [
    "enterprise",
    "modules",
    "package",
    "private",
    "proxy",
    "registry",
    "repository",
    "server",
    "verdaccio"
  ],
  "homepage": "https://verdaccio.org",
  "bugs": {
    "url": "https://github.com/verdaccio/verdaccio/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Juan Picado",
    "email": "juanpicado19@gmail.com"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/verdaccio/verdaccio",
    "directory": "packages/loaders"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/verdaccio"
  },
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "./build/*": "./build/*"
  },
  "scripts": {
    "clean": "rimraf ./build",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.build.json",
    "watch": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json"
  },
  "dependencies": {
    "@verdaccio/core": "workspace:8.3.0",
    "debug": "4.4.3",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@verdaccio-scope/verdaccio-auth-foo": "0.0.2",
    "@verdaccio/config": "workspace:8.3.0",
    "@verdaccio/core": "workspace:8.3.0",
    "@verdaccio/logger": "workspace:8.1.3",
    "verdaccio-auth-memory": "workspace:*",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
